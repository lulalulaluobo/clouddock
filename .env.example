# CloudDock 镜像版本；生产建议固定具体版本，不使用 latest。
CLOUDDOCK_VERSION=1.2.0
BIND_IP=0.0.0.0
APP_PORT=7003
TZ=Asia/Shanghai

# 必填：NAS 上实际下载目录，两个服务必须挂载同一目录。
NAS_DOWNLOAD_PATH=/vol3/1000/2T/飞牛影视
# 下载目录所有者的数字 UID/GID，请按 NAS 实际值填写。
PUID=1000
PGID=1001

# 可选：启用 compose.baidu.yaml 时填写，飞牛官方百度应用登录用户的数字 UID。
# 通常与 PUID 相同；不是百度账号或 CloudDock 用户 ID。
BAIDU_NAS_UID=1000

# 必填：首次注册管理员使用的 6～12 位数字；不是登录密码。
ADMIN_USER_CODE=
# 必填：随机 RPC 密钥，至少 32 位；应用和 aria2 自动共用此值。
ARIA2_RPC_SECRET=

# 可选：留空自动生成并保存到 config/env；重建容器不会更换。
# 自定义时至少 32 位，必须包含大写、小写、数字和特殊字符。
JWT_SECRET=
JWT_EXPIRES_IN=7d

# 可选：仅空数据库初始化时导入频道，之后在设置页维护。
# 填写 JSON，例如：[{"id":"实际频道用户名","name":"频道名称"}]
TELE_CHANNELS=[]
