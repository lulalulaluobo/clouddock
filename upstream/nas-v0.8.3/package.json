{
  "name": "cloud-saver-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nodemon --exec ts-node src/app.ts",
    "db:migrate": "ts-node src/bootstrap/migrate.ts",
    "db:init:dev": "ts-node src/bootstrap/devInit.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.{ts,md,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,md,json}\"",
    "build": "npm run typecheck && tsc",
    "postbuild": "javascript-obfuscator dist --output dist-final --target node --config obfuscator.config.json && cp -r src/sponsors dist-final/sponsors",
    "start": "node dist-final/app.js",
    "start:bot": "nodemon --exec ts-node src/start-bot.ts",
    "admin:recovery:list": "ts-node src/scripts/admin-recovery.ts list",
    "admin:recovery:reset": "ts-node src/scripts/admin-recovery.ts reset",
    "admin:recovery:activate": "ts-node src/scripts/admin-recovery.ts activate"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "bcrypt": "^5.1.1",
    "cheerio": "1.0.0",
    "cloud189-sdk": "1.0.6-alpha.5",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "https-proxy-agent": "^7.0.6",
    "inversify": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-telegram-bot-api": "^0.66.0",
    "rss-parser": "^3.13.0",
    "sequelize": "^6.37.5",
    "socket.io": "^4.8.1",
    "socks-proxy-agent": "^8.0.5",
    "sqlite3": "^5.1.7",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.11.25",
    "@types/node-telegram-bot-api": "^0.64.8",
    "@types/tunnel": "^0.0.7",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "javascript-obfuscator": "^4.1.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.8.1",
    "terser": "^5.29.1",
    "terser-folder": "^2.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.2",
    "vitest": "^4.0.18"
  }
}
